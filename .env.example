# Copy this file to .env and replace every CHANGE_ME value.
# Never commit your real .env file.

DB_URL=jdbc:mysql://localhost:3306/job_portal?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=jobportal_user
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Generate a unique random secret of at least 32 characters.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRATION_MINUTES=480

# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

UPLOAD_DIR=./uploads

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_NAME=Platform Administrator

# Set to false when deploying with production data.
SEED_DEMO_DATA=true
DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD
